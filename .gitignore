!.nojekyll
!.gitignore
!index.html
!robots.txt
!sitemap.xml
!apple-touch-icon.png
!style.css
!script.js
!track.js
!CNAME
!assets/
!assets/**
!articles/
!articles/**
!mail/
!mail/**
!lp/
!lp/**
!form/
!form/**

# ======================
# 3. macOS固有のファイルは常に除外
# ======================
.DS_Store


# Local Netlify folder
.netlify
!tools/
!tools/**
